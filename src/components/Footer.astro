---
import { SITE, socialLinks } from "../data/site";
const year = new Date().getFullYear();
const socials = socialLinks();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <a href="/#contact" class="footer__big"
      >Laten we iets<br /><em>moois bouwen.</em></a
    >
    <div class="footer__cols">
      {
        socials.length > 0 && (
          <div>
            <h2 class="footer__h">Elders</h2>
            {socials.map(([label, url]) => (
              <a href={url} rel="me noopener" target="_blank">
                {label}
              </a>
            ))}
          </div>
        )
      }
      <div>
        <h2 class="footer__h">Navigatie</h2>
        <a href="/werk/">Alle projecten</a>
        <a href="/#diensten">Diensten</a>
        <a href="/#freelance">Freelance</a>
        <a href="/#contact">Contact</a>
      </div>
    </div>
  </div>
  <div class="wrap footer__wordmark" aria-hidden="true">{SITE.name}</div>
  <div class="wrap footer__base">
    <!-- <span>© {year} {SITE.name} · KvK {SITE.kvk}</span> -->
    <span>Ontworpen &amp; gebouwd in eigen huis. Uiteraard.</span>
  </div>
</footer>
