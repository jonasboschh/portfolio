---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pagina niet gevonden | Jonas Bosch" description="Deze pagina bestaat niet (meer)." noindex>
  <section class="page-hero work">
    <div class="wrap">
      <p class="kicker reveal"><span>404</span> Niet gevonden</p>
      <h1 class="page-title reveal">Deze pagina<br /><em>bestaat niet.</em></h1>
      <p class="page-lede reveal">Misschien is hij verhuisd, of zat er een typfout in de link. Deze kunnen je verder helpen:</p>
      <div class="hero__actions reveal" style="margin-top:36px">
        <a href="/" class="btn btn--light magnetic">Naar de homepage <span aria-hidden="true">→</span></a>
        <a href="/werk/" class="btn btn--ghost magnetic" style="color:var(--paper);border-color:rgba(255,255,255,.2)">Bekijk mijn werk</a>
      </div>
    </div>
  </section>
</BaseLayout>
